
  generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
    moduleFormat = "cjs"
  }

  datasource db {
    provider = "postgresql"
  }

  enum UserRoles {
    GUEST
    USER
    ADMIN
    MODERATOR
  }

  model User {
    id         String      @id @default(uuid())
    email      String   @unique
    password   String
    name       String?
    role       UserRoles @default(GUEST)

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    @@map("users")
  }


    